APP_NAME=Sanjeevani AI
ENV=development

# SQLite by default - zero setup needed. For MySQL, set e.g.:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/sanjeevani_ai
DATABASE_URL=sqlite:///./data/sanjeevani.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
SESSION_HOURS=8

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=

EMERGENCY_NUMBER=112
MAX_UPLOAD_MB=5
